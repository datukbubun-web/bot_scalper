# ─────────────────────────────────────────────────────────────────────────────
#  PrimeXBT API v3 credentials
#  ---------------------------------------------------------------------------
#  IMPORTANT: PrimeXBT "API key" pages give you TWO values:
#     1) the key id  -> looks like  pxk_XXXXXXXXXXXXXXXXXXXX     (public)
#     2) the secret  -> an Ed25519 PRIVATE KEY in PKCS#8, base64  (shown once)
#
#  Requests are signed with the SECRET using Ed25519. The pxk_... id alone
#  CANNOT sign anything, so a value like "pxk_ab12..." is the *key id*, not
#  the secret. Paste the base64 PKCS#8 secret below.
#
#  Never commit the real .env. .gitignore already excludes it.
# ─────────────────────────────────────────────────────────────────────────────

PX_API_KEY=pxk_0e1yOqGu7oGTAgve12BUlZ
PX_API_SECRET=MC4CAQAwBQYDK2VwBCIEINcvA3P7pxj+AsLUlftu8z4zjmR6teNiotH/d3k/xPcF       # <- base64 PKCS#8 Ed25519 secret

# Optional: read-only key (catalogue/prices/positions). If empty, PX_API_KEY is used.
PX_API_KEY_READ=
PX_API_SECRET_READ=

# Comma separated list of symbols to trade/inspect, PrimeXBT naming: BASE/QUOTE
PX_SYMBOLS=XAU/USD

# ---------------------------------------------------------------------------
# LIVE TRADING MASTER SWITCH
# The bot refuses to send a single order unless PX_LIVE_TRADING=1 AND
# `--i-understand-the-risk` is passed on the CLI.
# ---------------------------------------------------------------------------
PX_LIVE_TRADING=0

# demo | live  (a demo account id starts with "D")
PX_ENVIRONMENT=demo

# Optional emergency risk overrides (uncomment to override YAML `risk:` fields;
# prefix MUST be `PX_RISK_` + exact RiskConfig field name in UPPERCASE):
# PX_RISK_MAX_INTRADAY_LOSS_PCT=2.0
# PX_RISK_MAX_DAILY_LOSS_PCT=2.5
# PX_RISK_MAX_DRAWDOWN_PCT=6.0
# PX_RISK_MAX_LEVERAGE=5.0
# PX_RISK_RISK_PER_TRADE_PCT=0.5

# Inference backend: onnx | torchscript | torch
PX_INFERENCE_BACKEND=onnx
PX_ARTIFACT_DIR=artifacts
PX_MODEL_VERSION=latest

# Prometheus / metrics endpoint
PX_METRICS_PORT=9101
